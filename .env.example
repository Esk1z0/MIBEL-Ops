# Copy this file to `.env` (ignored by Git) and fill in your own values.
# NEVER commit the real `.env`. See AGENTS.md §3.

# ESIOS (REE) personal token — request it by email to REE (see docs/05_data_sources.md §2.2)
ESIOS_TOKEN=<your-token-here>

# ENTSO-E Transparency Platform security token — register and request API access (docs/05_data_sources.md §2.4)
ENTSOE_TOKEN=<your-token-here>

# AEMET OpenData API key — optional (docs/05_data_sources.md §2.7)
AEMET_API_KEY=<your-token-here>

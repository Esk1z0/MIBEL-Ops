# Copy to /etc/mibel-ingestor/env (mode 0640, owner root:mibel). Placeholders only: never commit real values.
MIBEL_NODE_ID=<ingestor-name>
MIBEL_KAFKA_BOOTSTRAP=<manager-vpn-address>:9092
MIBEL_METRICS_HOST=<this-node-vpn-address>
ESIOS_TOKEN=<your-token-here>
ENTSOE_TOKEN=<your-token-here>
AEMET_API_KEY=<your-token-here>
